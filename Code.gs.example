// ==========================================
// Copy to Google Apps Script (Code.gs) → Deploy New version → Anyone
// Script Properties (optional overrides):
//   APP_USER, APP_PASS, APP_TOKEN, B_SHEET_ID, DAMAGE_SHEET_ID, DAMAGE_DRIVE_FOLDER_ID
// ==========================================

const USER = "YOUR_USERNAME";
const PASS = "YOUR_PASSWORD";
const MAIN_SHEET_ID = "YOUR_MAIN_SHEET_ID";
const DEFAULT_DAMAGE_SHEET_ID = ""; // set DAMAGE_SHEET_ID Script Property (required for damage)

const SPREADSHEET_MAP = {
  "P": { id: "YOUR_P_SHEET_ID", column: "E" },
  "E": { id: "YOUR_E_SHEET_ID", column: "E" },
  "I": { id: "YOUR_I_SHEET_ID", column: "E" },
  "C": { id: "YOUR_C_SHEET_ID", column: "E" },
  "B": { id: "YOUR_B_SHEET_ID", column: "E" }
};

// Damage tab: A=Date B=Code C=Name D=ImageURL E=DamagedBy F=Count G=Remark
const DAMAGE_TAB_NAME = "Damage";
const AUDIT_TAB_NAME = "AuditLog";
const RECEIVING_TAB_NAME = "Receiving";
const LIFECYCLE_TAB_NAME = "ToolLifecycle";
const CREDENTIALS_TAB_NAME = "Credentials";

const ROLE_RANK = { viewer: 1, store_keeper: 2, supervisor: 3, admin: 4 };

function getConfig_() {
  const props = PropertiesService.getScriptProperties();
  const bSheetId = props.getProperty("B_SHEET_ID");
  if (bSheetId) SPREADSHEET_MAP["B"].id = bSheetId;
  return {
    user: props.getProperty("APP_USER") || USER,
    pass: props.getProperty("APP_PASS") || PASS,
    token: props.getProperty("APP_TOKEN") || "CHANGE_ME_ROTATE_TOKEN",
    role: (props.getProperty("APP_ROLE") || "admin").toLowerCase(),
    damageSheetId: props.getProperty("DAMAGE_SHEET_ID") || DEFAULT_DAMAGE_SHEET_ID,
    damageDriveFolderId: props.getProperty("DAMAGE_DRIVE_FOLDER_ID") || "",
    opsSheetId: props.getProperty("OPS_SHEET_ID") || MAIN_SHEET_ID
  };
}

function isAuthorized_(token) {
  return token && token === getConfig_().token;
}

function roleAtLeast_(role, minRole) {
  return (ROLE_RANK[role] || 0) >= (ROLE_RANK[minRole] || 99);
}

function resolveLogin_(user, pass) {
  const cfg = getConfig_();
  if (user === cfg.user && pass === cfg.pass) {
    return { user: cfg.user, role: cfg.role, token: cfg.token };
  }
  try {
    const ss = SpreadsheetApp.openById(cfg.opsSheetId);
    const sheet = ss.getSheetByName(CREDENTIALS_TAB_NAME);
    if (!sheet || sheet.getLastRow() < 2) return null;
    const rows = sheet.getRange(2, 1, sheet.getLastRow(), 3).getDisplayValues();
    for (let i = 0; i < rows.length; i++) {
      const u = String(rows[i][0] || "").trim();
      const p = String(rows[i][1] || "").trim();
      const r = String(rows[i][2] || "viewer").trim().toLowerCase();
      if (u && u === user && p === pass) {
        return { user: u, role: ROLE_RANK[r] ? r : "viewer", token: cfg.token };
      }
    }
  } catch (e) { /* credentials sheet optional */ }
  return null;
}

function getOpsSpreadsheet_() {
  return SpreadsheetApp.openById(getConfig_().opsSheetId);
}

function getOrCreateNamedSheet_(ss, name, headers) {
  let sheet = ss.getSheetByName(name);
  if (!sheet) {
    sheet = ss.insertSheet(name);
    sheet.getRange(1, 1, 1, headers.length).setValues([headers]);
    sheet.getRange(1, 1, 1, headers.length).setFontWeight("bold");
  }
  return sheet;
}

function appendAudit_(entry) {
  try {
    const ss = getOpsSpreadsheet_();
    const sheet = getOrCreateNamedSheet_(ss, AUDIT_TAB_NAME, [
      "Timestamp", "User", "Role", "Action", "Before", "After", "Detail", "Device"
    ]);
    sheet.appendRow([
      entry.timestamp || new Date().toISOString(),
      entry.user || "",
      entry.role || "",
      entry.action || "",
      entry.before || "",
      entry.after || "",
      entry.detail || "",
      entry.device || ""
    ]);
    return true;
  } catch (e) {
    return false;
  }
}

function extractDate_(cellValue) {
  if (!cellValue) return "";
  const s = cellValue.toString().trim();
  const match = s.match(/\{([^}]+)\}/);
  return match ? match[0].trim() : s;
}

function formatDamageDate_(d) {
  const date = d || new Date();
  return Utilities.formatDate(date, Session.getScriptTimeZone(), "dd/MM/yyyy");
}

function internalGetDescription(scanData) {
  if (!scanData) return "NO CODE";
  const firstChar = scanData.charAt(0).toUpperCase();
  const sheetInfo = SPREADSHEET_MAP[firstChar];
  if (!sheetInfo) return "UNKNOWN CODE TYPE";
  try {
    const sheet = SpreadsheetApp.openById(sheetInfo.id).getActiveSheet();
    const lastRow = sheet.getLastRow();
    if (lastRow === 0) return "EMPTY SHEET";
    const values = sheet.getRange(1, 1, lastRow, sheet.getLastColumn()).getDisplayValues();
    const rowIndex = values.findIndex(row => row[0].toUpperCase() === scanData.toUpperCase());
    if (rowIndex !== -1) {
      const descColumn = sheetInfo.column.charCodeAt(0) - 65;
      return values[rowIndex][descColumn] || "NO DESCRIPTION WRITTEN";
    }
    return "DESCRIPTION NOT FOUND";
  } catch (e) {
    return "ERROR FETCHING";
  }
}

function getOrCreateDamageSheet_(ss) {
  let sheet = ss.getSheetByName(DAMAGE_TAB_NAME);
  if (!sheet) {
    sheet = ss.insertSheet(DAMAGE_TAB_NAME);
    sheet.getRange(1, 1, 1, 7).setValues([["Date", "Code", "Name", "ImageURL", "DamagedBy", "Count", "Remark"]]);
    sheet.getRange(1, 1, 1, 7).setFontWeight("bold");
  }
  return sheet;
}

function getDamagePhotoFolder_() {
  const cfg = getConfig_();
  const FOLDER_NAME = "ToolCustody-Damage-Photos";

  if (cfg.damageDriveFolderId) {
    return DriveApp.getFolderById(cfg.damageDriveFolderId);
  }

  const ssFile = DriveApp.getFileById(cfg.damageSheetId);
  const parents = ssFile.getParents();
  if (!parents.hasNext()) {
    throw new Error("Could not find Drive folder for damage spreadsheet");
  }
  const parent = parents.next();
  const existing = parent.getFoldersByName(FOLDER_NAME);
  if (existing.hasNext()) return existing.next();
  return parent.createFolder(FOLDER_NAME);
}

function uploadDamageImage_(base64Data, toolCode) {
  if (!base64Data) return "";
  const match = String(base64Data).match(/^data:(image\/\w+);base64,(.+)$/);
  const contentType = match ? match[1] : "image/jpeg";
  const raw = match ? match[2] : String(base64Data).replace(/^data:image\/\w+;base64,/, "");
  const bytes = Utilities.base64Decode(raw);
  const ext = contentType.indexOf("png") >= 0 ? "png" : "jpg";
  const safeCode = (toolCode || "item").replace(/[^\w-]/g, "_");
  const filename = "damage_" + safeCode + "_" + new Date().getTime() + "." + ext;
  const blob = Utilities.newBlob(bytes, contentType, filename);

  const folder = getDamagePhotoFolder_();
  const file = folder.createFile(blob);
  // Inherit folder ACL — do not publish Anyone-with-link
  return "https://drive.google.com/uc?export=view&id=" + file.getId();
}

function internalSubmitDamage_(params) {
  const cfg = getConfig_();
  const toolCode = (params.toolCode || params.code || "").toString().trim().toUpperCase();
  const personCode = (params.personCode || params.damagedBy || "").toString().trim().toUpperCase();
  const count = Math.max(1, Number(params.qty || params.count || 1) || 1);
  const remark = (params.remark || params.remarks || "").toString().trim() || "No remark";
  const rowDate = (params.date || "").toString().trim() || formatDamageDate_(new Date());
  const imageBase64 = params.imageBase64 || params.image || "";

  if (!toolCode) return { error: "Tool code is required" };
  if (!/^[IEBC]/.test(toolCode)) return { error: "Tool code must start with I, E, C, or B" };
  if (!personCode) return { error: "Person code is required" };
  if (!/^P/.test(personCode)) return { error: "Person code must start with P" };

  const toolName = internalGetDescription(toolCode);
  let imageUrl = "";
  let finalRemark = remark;
  if (imageBase64) {
    try {
      imageUrl = uploadDamageImage_(imageBase64, toolCode);
    } catch (err) {
      finalRemark = remark + " [Photo failed: " + err.message + "]";
    }
  }

  try {
    const ss = SpreadsheetApp.openById(cfg.damageSheetId);
    const sheet = getOrCreateDamageSheet_(ss);
    sheet.appendRow([rowDate, toolCode, toolName, imageUrl, personCode, count, finalRemark]);
    const nextRow = sheet.getLastRow();
    return {
      success: true,
      row: nextRow,
      item: {
        date: rowDate,
        code: toolCode,
        name: toolName,
        image: imageUrl,
        damagedBy: personCode,
        count: count,
        remark: finalRemark
      }
    };
  } catch (err) {
    return { error: "Sheet write failed: " + err.message + " (check script access to sheet " + cfg.damageSheetId + ")" };
  }
}

function normalizeDateKey_(cellValue) {
  if (!cellValue) return "";
  return extractDate_(cellValue).replace(/[{}]/g, "").trim();
}

function internalGetDamageDates_() {
  const cfg = getConfig_();
  try {
    const ss = SpreadsheetApp.openById(cfg.damageSheetId);
    const sheet = ss.getSheetByName(DAMAGE_TAB_NAME);
    if (!sheet || sheet.getLastRow() < 2) return [];

    const rows = sheet.getRange(2, 1, sheet.getLastRow(), 1).getDisplayValues();
    const dates = rows.map(r => normalizeDateKey_(r[0])).filter(String);
    return [...new Set(dates)].reverse();
  } catch (err) {
    return { error: err.message };
  }
}

function internalGetDamage_(targetDate) {
  const cfg = getConfig_();
  try {
    const ss = SpreadsheetApp.openById(cfg.damageSheetId);
    const sheet = ss.getSheetByName(DAMAGE_TAB_NAME);
    if (!sheet) return [];

    const lastRow = sheet.getLastRow();
    if (lastRow < 2) return [];

    const rows = sheet.getRange(2, 1, lastRow, 7).getDisplayValues();
    const items = [];

    rows.forEach(row => {
      const rowDate = normalizeDateKey_(row[0]);
      const filterDate = normalizeDateKey_(targetDate);
      if (targetDate && rowDate !== filterDate) return;

      const code = (row[1] || "").toString().trim();
      const name = (row[2] || "").toString().trim();
      const image = (row[3] || "").toString().trim();
      const damagedBy = (row[4] || "").toString().trim() || "Unknown";
      const count = Number(row[5]) || 1;
      const remark = (row[6] || "").toString().trim() || "No remark";

      if (!code && !name && !damagedBy) return;

      items.push({
        code: code,
        name: name || internalGetDescription(code) || code || "Unnamed product",
        image: image,
        damagedBy: damagedBy,
        count: count,
        remark: remark,
        date: rowDate
      });
    });

    return items;
  } catch (err) {
    return { error: err.message };
  }
}

function handleRequest_(params) {
  const action = params.action;
  const cfg = getConfig_();

  if (action === "options") return json({ ok: true });

  if (action === "login") {
    const account = resolveLogin_(params.user, params.pass);
    if (account) {
      appendAudit_({
        user: account.user,
        role: account.role,
        action: "LOGIN",
        detail: "success",
        device: params.device || ""
      });
      return json({
        success: true,
        token: account.token,
        role: account.role,
        user: account.user
      });
    }
    return json({ success: false });
  }

  if (action === "getDesc") {
    if (!isAuthorized_(params.token)) return json({ error: "UNAUTHORIZED" });
    const code = (params.code || "").toUpperCase().trim();
    if (!code) return json({ description: "NO CODE" });
    return json({ description: internalGetDescription(code) });
  }

  const scanData = params.scanData;
  if (scanData) {
    if (!isAuthorized_(params.token)) return json({ error: "UNAUTHORIZED" });
    const lock = LockService.getScriptLock();
    try {
      lock.waitLock(5000);
      const sheet = SpreadsheetApp.openById(MAIN_SHEET_ID).getActiveSheet();
      const colBValues = sheet.getRange("B1:B").getValues();
      let nextRow = 2;
      for (let i = 1; i < colBValues.length; i++) {
        if (!colBValues[i][0] || colBValues[i][0].toString().trim() === "") {
          nextRow = i + 1;
          break;
        }
      }
      sheet.getRange(nextRow, 2).setValue(scanData.toUpperCase());
      return json({ status: "OK" });
    } catch (error) {
      return json({ error: "SERVER_BUSY" });
    } finally {
      lock.releaseLock();
    }
  }

  if (action && !isAuthorized_(params.token)) {
    return json({ error: "UNAUTHORIZED" });
  }

  if (action === "getDates") {
    try {
      const sheet = SpreadsheetApp.openById(MAIN_SHEET_ID).getActiveSheet();
      const lastRow = sheet.getLastRow();
      if (lastRow < 2) return json([]);

      const rows = sheet.getRange(2, 8, lastRow, 1).getDisplayValues();
      const datesList = [];
      rows.forEach(row => {
        const cellValue = row[0].trim();
        if (!cellValue) return;
        datesList.push(extractDate_(cellValue));
      });
      return json([...new Set(datesList)].filter(String));
    } catch (err) {
      return json({ error: err.message });
    }
  }

  if (action === "getData") {
    const targetDate = params.date;
    try {
      const sheet = SpreadsheetApp.openById(MAIN_SHEET_ID).getActiveSheet();
      const lastRow = sheet.getLastRow();
      if (lastRow < 2) return json([]);

      const rows = sheet.getRange(2, 1, lastRow, 8).getDisplayValues();
      const historyData = [];

      for (let i = 0; i < rows.length; i++) {
        const qrCode = rows[i][1];
        const timestamp = (rows[i][7] || "").toString().trim();
        if (!qrCode) continue;
        historyData.push({
          toolCode: qrCode,
          rowDate: extractDate_(timestamp),
          timestamp: timestamp
        });
      }

      const uniqueCodes = [...new Set(historyData.map(d => d.toolCode))];
      const descMap = {};
      uniqueCodes.forEach(c => { descMap[c] = internalGetDescription(c); });

      return json(historyData.map(d => ({
        toolCode: d.toolCode,
        toolDescription: descMap[d.toolCode],
        rowDate: d.rowDate,
        timestamp: d.timestamp,
        isTargetDay: (d.rowDate === targetDate)
      })));
    } catch (err) {
      return json({ error: err.message });
    }
  }

  if (action === "getDamageDates") {
    const result = internalGetDamageDates_();
    if (result && result.error) return json(result);
    return json(result);
  }

  if (action === "getDamage") {
    const targetDate = params.date || "";
    const result = internalGetDamage_(targetDate);
    if (result && result.error) return json(result);
    return json({ items: result });
  }

  if (action === "submitDamage") {
    const result = internalSubmitDamage_(params);
    if (result && result.error) return json(result);
    appendAudit_({
      user: params.user || "",
      role: params.role || "",
      action: "DAMAGE_CREATE",
      after: JSON.stringify(result && result.item ? result.item : {}),
      device: params.device || ""
    });
    return json(result);
  }

  if (action === "auditLog") {
    const ok = appendAudit_({
      user: params.user || "",
      role: params.role || "",
      action: params.auditAction || params.event || "CLIENT_EVENT",
      before: params.before || "",
      after: params.after || "",
      detail: params.detail || "",
      device: params.device || ""
    });
    return json({ success: ok, ok: ok });
  }

  if (action === "getAuditLog") {
    try {
      const ss = getOpsSpreadsheet_();
      const sheet = ss.getSheetByName(AUDIT_TAB_NAME);
      if (!sheet || sheet.getLastRow() < 2) return json({ items: [] });
      const last = sheet.getLastRow();
      const start = Math.max(2, last - 199);
      const rows = sheet.getRange(start, 1, last, 8).getDisplayValues();
      const items = rows.map(r => ({
        timestamp: r[0], user: r[1], role: r[2], action: r[3],
        before: r[4], after: r[5], detail: r[6], device: r[7]
      })).reverse();
      return json({ items: items });
    } catch (err) {
      return json({ error: err.message, items: [] });
    }
  }

  if (action === "receiveItem") {
    const code = (params.code || "").toString().trim().toUpperCase();
    const description = (params.description || "").toString().trim();
    const supplier = (params.supplier || "").toString().trim();
    const invoice = (params.invoice || "").toString().trim();
    const po = (params.po || params.purchaseOrder || "").toString().trim();
    const cost = (params.cost || "").toString().trim();
    const warranty = (params.warranty || "").toString().trim();
    if (!code) return json({ error: "Code required" });
    if (!/^[PIECB]/.test(code)) return json({ error: "Code must start with P, I, E, C, or B" });
    if (!description) return json({ error: "Description required" });
    try {
      const prefix = code.charAt(0);
      const sheetInfo = SPREADSHEET_MAP[prefix];
      if (!sheetInfo || !sheetInfo.id || sheetInfo.id.indexOf("YOUR_") === 0) {
        return json({ error: "Catalog sheet not configured for " + prefix });
      }
      const cat = SpreadsheetApp.openById(sheetInfo.id).getActiveSheet();
      cat.appendRow([code, "", "", "", description]);
      const ss = getOpsSpreadsheet_();
      const recv = getOrCreateNamedSheet_(ss, RECEIVING_TAB_NAME, [
        "Timestamp", "Code", "Description", "Supplier", "Invoice", "PO", "Cost", "Warranty", "ByUser"
      ]);
      recv.appendRow([
        new Date().toISOString(), code, description, supplier, invoice, po, cost, warranty,
        params.user || ""
      ]);
      const life = getOrCreateNamedSheet_(ss, LIFECYCLE_TAB_NAME, [
        "Code", "State", "UpdatedAt", "Note", "ByUser"
      ]);
      life.appendRow([code, "Active", new Date().toISOString(), "Received", params.user || ""]);
      appendAudit_({
        user: params.user || "",
        role: params.role || "",
        action: "RECEIVE_ITEM",
        after: JSON.stringify({ code: code, description: description, supplier: supplier, cost: cost }),
        device: params.device || ""
      });
      return json({ success: true, code: code, description: description });
    } catch (err) {
      return json({ error: err.message });
    }
  }

  if (action === "getReceiving") {
    try {
      const ss = getOpsSpreadsheet_();
      const sheet = ss.getSheetByName(RECEIVING_TAB_NAME);
      if (!sheet || sheet.getLastRow() < 2) return json({ items: [] });
      const rows = sheet.getRange(2, 1, sheet.getLastRow(), 9).getDisplayValues().reverse();
      return json({
        items: rows.slice(0, 100).map(r => ({
          timestamp: r[0], code: r[1], description: r[2], supplier: r[3],
          invoice: r[4], po: r[5], cost: r[6], warranty: r[7], byUser: r[8]
        }))
      });
    } catch (err) {
      return json({ error: err.message, items: [] });
    }
  }

  if (action === "setLifecycle") {
    const code = (params.code || "").toString().trim().toUpperCase();
    const state = (params.state || "").toString().trim();
    const note = (params.note || "").toString().trim();
    const allowed = ["Active", "Under Repair", "Awaiting Parts", "Scrap", "Returned"];
    if (!code) return json({ error: "Code required" });
    if (allowed.indexOf(state) < 0) return json({ error: "Invalid state" });
    try {
      const ss = getOpsSpreadsheet_();
      const sheet = getOrCreateNamedSheet_(ss, LIFECYCLE_TAB_NAME, [
        "Code", "State", "UpdatedAt", "Note", "ByUser"
      ]);
      sheet.appendRow([code, state, new Date().toISOString(), note, params.user || ""]);
      appendAudit_({
        user: params.user || "",
        role: params.role || "",
        action: "LIFECYCLE_CHANGE",
        after: JSON.stringify({ code: code, state: state, note: note }),
        device: params.device || ""
      });
      return json({ success: true, code: code, state: state });
    } catch (err) {
      return json({ error: err.message });
    }
  }

  if (action === "getLifecycle") {
    try {
      const ss = getOpsSpreadsheet_();
      const sheet = ss.getSheetByName(LIFECYCLE_TAB_NAME);
      if (!sheet || sheet.getLastRow() < 2) return json({ items: [] });
      const rows = sheet.getRange(2, 1, sheet.getLastRow(), 5).getDisplayValues();
      const latest = {};
      rows.forEach(r => {
        const code = String(r[0] || "").toUpperCase();
        if (!code) return;
        latest[code] = { code: code, state: r[1], updatedAt: r[2], note: r[3], byUser: r[4] };
      });
      const filter = (params.code || "").toString().trim().toUpperCase();
      let items = Object.keys(latest).map(k => latest[k]);
      if (filter) items = items.filter(i => i.code === filter);
      return json({ items: items });
    } catch (err) {
      return json({ error: err.message, items: [] });
    }
  }

  if (action === "searchAll") {
    const q = (params.q || "").toString().trim().toUpperCase();
    if (!q || q.length < 1) return json({ items: [] });
    try {
      const sheet = SpreadsheetApp.openById(MAIN_SHEET_ID).getActiveSheet();
      const lastRow = sheet.getLastRow();
      if (lastRow < 2) return json({ items: [] });
      const rows = sheet.getRange(2, 1, lastRow, 8).getDisplayValues();
      const items = [];
      for (let i = rows.length - 1; i >= 0 && items.length < 80; i--) {
        const code = String(rows[i][1] || "").toUpperCase();
        const ts = String(rows[i][7] || "");
        if (!code) continue;
        if (code.indexOf(q) >= 0 || ts.toUpperCase().indexOf(q) >= 0) {
          items.push({
            type: code.charAt(0) === "P" ? "person" : (code === "IN" || code === "OUT" ? "direction" : "tool"),
            code: code,
            timestamp: ts,
            rowDate: extractDate_(ts)
          });
        }
      }
      return json({ items: items, q: q });
    } catch (err) {
      return json({ error: err.message, items: [] });
    }
  }

  return json({ error: "NO ACTION SPECIFIED" });
}

function doGet(e) {
  return handleRequest_((e && e.parameter) || {});
}

function doPost(e) {
  var params = (e && e.parameter) ? e.parameter : {};
  if (e && e.postData && e.postData.contents) {
    var type = (e.postData.type || "").toLowerCase();
    if (type.indexOf("text/plain") >= 0 || type.indexOf("application/json") >= 0) {
      try {
        params = JSON.parse(e.postData.contents);
      } catch (err) {
        return json({ error: "INVALID_JSON" });
      }
    }
  }
  return handleRequest_(params);
}

function json(o) {
  return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);
}
